# TV Home server: the home page and its API. Generated by systemd/install-units.
[Unit]
Description=TV Home server (LG TV home page and its API)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=@ROOT@/server
Environment=PATH=@PATH@
ExecStart=@PYTHON@ -u @ROOT@/server/tvhome_server.py
Restart=on-failure
RestartSec=10
UMask=0077

[Install]
WantedBy=default.target
