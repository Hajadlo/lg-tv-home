# Launch TV Home when the LG TV turns on; with [tv] takeover the Home button
# opens TV Home too. Generated by systemd/install-units.
[Unit]
Description=TV Home: launch the TV Home app when the TV turns on
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=PATH=@PATH@
WorkingDirectory=%h
ExecStart=@UV@ run -q --no-project --with aiowebostv python -I @ROOT@/tv/autolaunch.py --settle-seconds 1
Restart=always
RestartSec=10
UMask=0077

[Install]
WantedBy=default.target
