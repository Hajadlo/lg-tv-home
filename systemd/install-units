#!/usr/bin/env bash
# Write the TV Home systemd user units with this checkout's path filled in.
#
#   systemd/install-units [--enable] [--print]
#
# --print   show the generated units, write nothing
# --enable  also enable and start them (server, autolaunch, renewal timer)
#
# The units go to ~/.config/systemd/user/. They capture today's PATH entries
# for python3, uv, node and ares, so run this from a shell where those work.
# For the server to run while nobody is logged in: loginctl enable-linger "$USER".
set -euo pipefail
here="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
root="$(dirname "$here")"
print=0; enable=0
for a in "$@"; do
    case "$a" in
        --print) print=1 ;;
        --enable) enable=1 ;;
        -h|--help) sed -n '2,12p' "$0"; exit 0 ;;
        *) echo "unknown argument: $a" >&2; exit 2 ;;
    esac
done

python="$(command -v python3)" || { echo "python3 not found" >&2; exit 1; }
"$python" -c 'import sys; sys.exit(sys.version_info < (3, 11))' || { echo "need Python 3.11+ (tomllib)" >&2; exit 1; }
uv="$(command -v uv || true)"
[ -n "$uv" ] || echo "warning: uv not found; tv-home-autolaunch needs it (https://docs.astral.sh/uv/)" >&2
command -v ares-novacom >/dev/null || echo "warning: ares CLI not on PATH; tv-home-devmode-renew needs it" >&2

# PATH for the units: the dirs of the tools found now, then the usual ones.
path=""
for t in python3 uv node ares-novacom ssh; do
    p="$(command -v "$t" 2>/dev/null || true)"
    [ -n "$p" ] || continue
    d="$(dirname "$p")"
    case ":$path:" in *":$d:"*) ;; *) path="${path:+$path:}$d" ;; esac
done
for d in /usr/local/bin /usr/bin /bin; do
    case ":$path:" in *":$d:"*) ;; *) path="$path:$d" ;; esac
done

dest="$HOME/.config/systemd/user"
[ "$print" = 1 ] || mkdir -p "$dest"
for src in "$here"/*.in; do
    name="$(basename "$src" .in)"
    out="$(sed -e "s|@ROOT@|$root|g" -e "s|@PATH@|$path|g" -e "s|@PYTHON@|$python|g" -e "s|@UV@|${uv:-uv}|g" "$src")"
    if [ "$print" = 1 ]; then
        printf '### %s\n%s\n\n' "$name" "$out"
    else
        printf '%s\n' "$out" > "$dest/$name"
        echo "wrote $dest/$name"
    fi
done
[ "$print" = 1 ] && exit 0
systemctl --user daemon-reload
if [ "$enable" = 1 ]; then
    systemctl --user enable --now tv-home.service tv-home-autolaunch.service tv-home-devmode-renew.timer
else
    echo "enable with: systemctl --user enable --now tv-home.service tv-home-autolaunch.service tv-home-devmode-renew.timer"
fi
